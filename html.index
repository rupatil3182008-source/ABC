
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopEase - Online Shopping</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f6fa;
            color: #222;
        }

        header {
            background: #172554;
            color: white;
            padding: 18px 6%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
        }

        .logo {
            font-size: 27px;
            font-weight: bold;
            color: #facc15;
        }

        .search {
            display: flex;
            flex: 1;
            max-width: 450px;
        }

        .search input {
            width: 100%;
            padding: 11px;
            border: none;
            border-radius: 5px 0 0 5px;
            outline: none;
        }

        .search button {
            padding: 11px 15px;
            border: none;
            background: #facc15;
            cursor: pointer;
            border-radius: 0 5px 5px 0;
        }

        .cart {
            font-size: 17px;
            font-weight: bold;
        }

        nav {
            background: white;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px #ddd;
        }

        nav button {
            border: none;
            background: transparent;
            padding: 8px 15px;
            cursor: pointer;
            font-size: 15px;
        }

        nav button:hover {
            color: #2563eb;
        }

        .hero {
            margin: 25px auto;
            width: 90%;
            padding: 45px 25px;
            border-radius: 12px;
            text-align: center;
            color: white;
            background: linear-gradient(120deg, #2563eb, #7c3aed);
        }

        .hero h1 {
            font-size: 36px;
            margin-bottom: 12px;
        }

        .hero p {
            margin-bottom: 20px;
        }

        .hero a {
            display: inline-block;
            background: #facc15;
            color: #172554;
            padding: 12px 22px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        h2 {
            text-align: center;
            margin: 30px 0 20px;
        }

        .products {
            width: 90%;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 22px;
            padding-bottom: 40px;
        }

        .product {
            background: white;
            border-radius: 10px;
            padding: 18px;
            text-align: center;
            box-shadow: 0 3px 12px #ddd;
            transition: transform 0.2s;
        }

        .product:hover {
            transform: translateY(-5px);
        }

        .product .emoji {
            font-size: 75px;
            padding: 15px;
            background: #f8fafc;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .product h3 {
            margin: 10px 0;
        }

        .price {
            color: #15803d;
            font-size: 20px;
            font-weight: bold;
            margin: 12px 0;
        }

        .product button {
            background: #2563eb;
            color: white;
            border: none;
            padding: 11px 18px;
            border-radius: 5px;
            cursor: pointer;
            width: 100%;
        }

        .product button:hover {
            background: #1d4ed8;
        }

        #message {
            text-align: center;
            color: #b91c1c;
            margin: 15px;
        }

        footer {
            background: #172554;
            color: white;
            text-align: center;
            padding: 22px;
            margin-top: 20px;
        }

        @media (max-width: 600px) {
            header {
                justify-content: center;
            }

            .search {
                order: 3;
                flex-basis: 100%;
            }

            .hero h1 {
                font-size: 27px;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">ShopEase</div>

        <div class="search">
            <input type="text" id="searchInput"
                   placeholder="Search products...">
            <button onclick="searchProducts()">Search</button>
        </div>

        <div class="cart">
            🛒 Cart: <span id="cartCount">0</span>
        </div>
    </header>

    <nav>
        <button onclick="filterProducts('All')">All</button>
        <button onclick="filterProducts('Electronics')">Electronics</button>
        <button onclick="filterProducts('Fashion')">Fashion</button>
        <button onclick="filterProducts('Home')">Home</button>
        <button onclick="filterProducts('Accessories')">Accessories</button>
    </nav>

    <section class="hero">
        <h1>Welcome to ShopEase!</h1>
        <p>Discover amazing products at affordable prices.</p>
        <a href="#products">Shop Now</a>
    </section>

    <h2 id="products">Our Products</h2>

    <p id="message"></p>

    <section class="products">

        <div class="product" data-category="Electronics">
            <div class="emoji">🎧</div>
            <h3>Wireless Headphones</h3>
            <p>High-quality sound</p>
            <div class="price">₹1,499</div>
            <button onclick="addToCart('Wireless Headphones')">
                Add to Cart
            </button>
        </div>

        <div class="product" data-category="Electronics">
            <div class="emoji">⌚</div>
            <h3>Smart Watch</h3>
            <p>Track your daily activity</p>
            <div class="price">₹2,499</div>
            <button onclick="addToCart('Smart Watch')">
                Add to Cart
            </button>
        </div>

        <div class="product" data-category="Fashion">
            <div class="emoji">👕</div>
            <h3>Casual T-Shirt</h3>
            <p>Comfortable everyday wear</p>
            <div class="price">₹599</div>
            <button onclick="addToCart('Casual T-Shirt')">
                Add to Cart
            </button>
        </div>

        <div class="product" data-category="Fashion">
            <div class="emoji">👟</div>
            <h3>Sports Shoes</h3>
            <p>Lightweight and stylish</p>
            <div class="price">₹1,899</div>
            <button onclick="addToCart('Sports Shoes')">
                Add to Cart
            </button>
        </div>

        <div class="product" data-category="Home">
            <div class="emoji">💡</div>
            <h3>Smart Table Lamp</h3>
            <p>Modern home lighting</p>
            <div class="price">₹799</div>
            <button onclick="addToCart('Smart Table Lamp')">
                Add to Cart
            </button>
        </div>

        <div class="product" data-category="Accessories">
            <div class="emoji">🎒</div>
            <h3>Travel Backpack</h3>
            <p>Perfect for college and travel</p>
            <div class="price">₹999</div>
            <button onclick="addToCart('Travel Backpack')">
                Add to Cart
            </button>
        </div>

    </section>

    <footer>
        <p>© 2026 ShopEase | Online Shopping Website</p>
        <p>Contact: support@shopease.example</p>
    </footer>

    <script>
        let cartCount = 0;

        function addToCart(productName) {
            cartCount++;
            document.getElementById("cartCount").textContent = cartCount;
            alert(productName + " added to cart!");
        }

        function filterProducts(category) {
            const products = document.querySelectorAll(".product");
            let visibleCount = 0;

            products.forEach(product => {
                const matches =
                    category === "All" ||
                    product.dataset.category === category;

                product.style.display = matches ? "block" : "none";

                if (matches) visibleCount++;
            });

            document.getElementById("message").textContent =
                visibleCount === 0 ? "No products found." : "";
        }

        function searchProducts() {
            const query = document.getElementById("searchInput")
                .value.toLowerCase().trim();

            const products = document.querySelectorAll(".product");
            let visibleCount = 0;

            products.forEach(product => {
                const matches = product.textContent
                    .toLowerCase().includes(query);

                product.style.display = matches ? "block" : "none";

                if (matches) visibleCount++;
            });

            document.getElementById("message").textContent =
                visibleCount === 0 ? "No products found." : "";
        }

        document.getElementById("searchInput")
            .addEventListener("keydown", function(event) {
                if (event.key === "Enter") {
                    searchProducts();
                }
            });
    </script>

</body>
</html>
